//change le registre pour modifié la PIN en in/output pour faire fonctionner la matrice
void LED_MODE(char pin, GPIO_TypeDef *group, char mode) {
	if (mode == OUTMODE) {
		group->MODER |= (0x1 << (pin * 2));
	}
	if (mode == INMODE) {
		group->MODER &= ~(0x3 << (pin * 2));
	}
}

